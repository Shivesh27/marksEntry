{
  "name": "marks-entry",
  "version": "1.0.0",
  "description": "Fast desktop marks entry application",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build:web": "vite build",
    "build:python": "pyinstaller --noconfirm --onefile --name marks_backend --distpath backend/dist --workpath backend/build --specpath backend backend/marks_backend.py",
    "dist": "npm run build:web && npm run build:python && electron-builder"
  },
  "build": {
    "appId": "com.srikakatiya.marksentry",
    "productName": "Marks Entry",
    "directories": { "output": "release" },
    "files": ["web-dist/**", "electron/**", "package.json"],
    "extraResources": [{ "from": "backend/dist/marks_backend", "to": "backend/marks_backend" }],
    "mac": { "target": ["dmg"] }
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "concurrently": "latest",
    "electron": "latest",
    "electron-builder": "24.13.3",
    "vite": "5.4.21",
    "wait-on": "latest"
  },
  "dependencies": { "react": "latest", "react-dom": "latest" }
}
